{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":ignoreUnstable"
  ],
  "packageRules": [
    {
      "description": "Tidy Go module files and rewrite import paths on major updates to satisfy CI",
      "matchManagers": [
        "gomod"
      ],
      "postUpdateOptions": [
        "gomodTidy",
        "gomodUpdateImportPaths"
      ]
    },
    {
      "description": "The base updater owns the verified runtime base image pins",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "saltydk/alpine-s6overlay",
        "gcr.io/distroless/static-debian13"
      ],
      "enabled": false
    },
    {
      "description": "Use published tags for shared container security actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "saltyorg/github-actions"
      ],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the govulncheck release run by the master and release Go checks",
      "managerFilePatterns": [
        "/^\\.github/actions/prepare-go/action\\.yml$/",
        "/^\\.github/workflows/release-govulncheck\\.yml$/"
      ],
      "matchStrings": [
        "golang\\.org/x/vuln/cmd/govulncheck@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    }
  ]
}
