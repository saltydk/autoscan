ARG BASE_IMAGE="gcr.io/distroless/static-debian13:nonroot@sha256:516757106de35205efb70b91ba03f6f1298424a0678c603255cf2852a7000087"

FROM ${BASE_IMAGE}

ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT

ENV \
  PATH="/app/autoscan:${PATH}" \
  AUTOSCAN_CONFIG="/config/config.yml" \
  AUTOSCAN_DATABASE="/config/autoscan.db" \
  AUTOSCAN_LOG="/config/activity.log" \
  AUTOSCAN_VERBOSITY="0" \
  XDG_CONFIG_HOME="/config/.config" \
  XDG_CACHE_HOME="/config/.cache" \
  XDG_DATA_HOME="/config/.local/share" \
  TZ="Etc/UTC"

USER 65532:65532
WORKDIR /config

COPY ["binaries/${TARGETOS}_${TARGETARCH}${TARGETVARIANT:+_7}/autoscan", "/app/autoscan/autoscan"]

ARG BASE_IMAGE
LABEL org.opencontainers.image.base.name="${BASE_IMAGE}"

VOLUME ["/config"]
EXPOSE 3030
ENTRYPOINT ["/app/autoscan/autoscan"]
